# Copy to backend/.env. backend/.env is git-ignored and must never be committed.

# mock (default, no key, no network) | openai | anthropic | fail (every model call fails)
LLM_PROVIDER=mock

# Only needed for live-model checks. Paste a key ONLY into backend/.env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Hard cap on live model calls (stored in SQLite); after this the app uses mock responses.
LIVE_CALL_LIMIT=50
MODEL_TIMEOUT_SECONDS=6

# Lets the frontend's ?simulateFailure=1 force a model failure for demos/tests. Set 0 to disable.
ALLOW_FAILURE_SIMULATION=1
